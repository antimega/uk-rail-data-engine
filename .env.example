# Copy to .env and fill in. NEVER commit .env - see README "Rules of use".
# Your National Rail Data Portal login (https://opendata.nationalrail.co.uk).
# The DTD licence makes access personal to you and non-assignable.
NRDP_USERNAME=you@example.com
NRDP_PASSWORD=

# Optional: override where data lives (default: ./data)
# RAIL_DATA_DIR=/path/to/data
